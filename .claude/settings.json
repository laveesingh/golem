      "Bash(git stash:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "Bash(git init:*)",
      "Bash(git clone:*)",
