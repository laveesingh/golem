      "Bash(yq:*)",

      "Bash(golem:*)",
      "Bash(bash:*)",

      "Skill(golem:lead)",
      "Skill(golem:exploring)",
      "Skill(golem:building)",
      "Skill(golem:tracker)",
      "Skill(golem:verify-done)",
