{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "cli/bootstrap.ts",
    "tools/tokens-core.ts",
    "tools/tokens-io.ts",
    "tools/tokens-build.ts",
    "tools/lint-tokens.ts",
    "tools/token-lint-parser.ts"
  ]
}
