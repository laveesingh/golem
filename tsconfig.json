{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "cli/bootstrap.ts",
    "tools/scenario-format.ts",
    "tools/scenario-scrub-core.ts",
    "tools/scenario-io.ts",
    "tools/scenario-scrub.ts",
    "test/sim/support.ts",
    "lib/contracts/pilot.ts",
    "lib/contracts/cli.ts",
    "lib/contracts/index.ts",
    "lib/cli-envelope.ts",
    "lib/contracts/config.ts",
    "lib/read-versioned.ts",
    "lib/golem-config.ts",
    "lib/session-role.ts",
    "lib/config-role-default.ts",
    "dashboard/server/contract-policy.ts",
    "dashboard/server/contract-pilot.ts",
    "tools/contracts-build.ts",
    "dashboard/web/src/api/pilot-client.ts",
    "lib/package-root.ts",
    "lib/compiler/runtime-source.ts",
    "lib/compiler/render-runtime.ts",
    "lib/compiler/render-types.ts",
    "tools/tokens-core.ts",
    "tools/tokens-io.ts",
    "tools/tokens-build.ts",
    "tools/lint-tokens.ts",
    "tools/token-lint-parser.ts",
    "tools/token-package.ts",
    "tools/token-defaults.ts",
    "tools/package-stage.ts"
  ]
}
