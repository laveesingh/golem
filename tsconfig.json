{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "cli/bootstrap.ts",
    "lib/contracts/pilot.ts",
    "dashboard/server/contract-policy.ts",
    "dashboard/server/contract-pilot.ts",
    "tools/contracts-build.ts",
    "dashboard/web/src/api/pilot-client.ts"
  ]
}
