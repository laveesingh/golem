{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "cli/bootstrap.ts",
    "tools/scenario-format.ts",
    "tools/scenario-scrub-core.ts",
    "tools/scenario-io.ts",
    "tools/scenario-scrub.ts",
    "test/sim/support.ts"
  ]
}
