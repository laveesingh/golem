{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "cli/bootstrap.ts",
      "tools/**",
      "test/support/**",
      "test/unit/**",
      "test/integration/**",
      "vitest.config.mjs",
      "tsconfig.json",
      "biome.json",
      "test/fixtures/w2-safety-probe.mjs",
      "test/cli-verb-help.test.mjs",
      "test/model-providers.test.mjs",
      "dashboard/scripts/_scratch.mjs",
      "test/sim/**",
      "lib/contracts/**",
      "lib/cli-envelope.ts",
      "test/fixtures/cli-envelope-probe.mjs",
      "dashboard/server/contract-*.ts",
      "dashboard/web/src/api/pilot-client.ts",
      "test/fixtures/w3-*.mjs",
      "lib/package-root.ts",
      "lib/compiler/runtime-source.ts",
      "lib/compiler/render-runtime.ts",
      "lib/compiler/render-types.ts",
      "test/artefact/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
