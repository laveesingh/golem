{
  "$id": "ScenarioFixture",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "schema": {
      "const": 1,
      "type": "number"
    },
    "scenario": {
      "anyOf": [
        {
          "const": "typed-brief-accepted-settled",
          "type": "string"
        },
        {
          "const": "claude-dispatch-ack-return",
          "type": "string"
        },
        {
          "const": "herdr-worker-lifecycle",
          "type": "string"
        },
        {
          "const": "dashboard-restart-stranded-envelope",
          "type": "string"
        }
      ]
    },
    "source": {
      "$id": "ScenarioSource",
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "harness": {
          "anyOf": [
            {
              "const": "claudecode",
              "type": "string"
            },
            {
              "const": "pi",
              "type": "string"
            },
            {
              "const": "herdr",
              "type": "string"
            }
          ]
        },
        "harness_version": {
          "minLength": 1,
          "type": "string"
        },
        "golem_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "harness",
        "harness_version",
        "golem_version"
      ]
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$id": "ScenarioEvent",
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "seq": {
            "minimum": 1,
            "type": "integer"
          },
          "at_ms": {
            "minimum": 0,
            "type": "integer"
          },
          "boundary": {
            "anyOf": [
              {
                "const": "hook",
                "type": "string"
              },
              {
                "const": "mcp",
                "type": "string"
              },
              {
                "const": "typed-http",
                "type": "string"
              },
              {
                "const": "process",
                "type": "string"
              },
              {
                "const": "herdr",
                "type": "string"
              }
            ]
          },
          "direction": {
            "anyOf": [
              {
                "const": "in",
                "type": "string"
              },
              {
                "const": "out",
                "type": "string"
              }
            ]
          },
          "operation": {
            "anyOf": [
              {
                "const": "hook-input",
                "type": "string"
              },
              {
                "const": "mcp-call",
                "type": "string"
              },
              {
                "const": "mcp-return",
                "type": "string"
              },
              {
                "const": "typed-submit",
                "type": "string"
              },
              {
                "const": "typed-accepted",
                "type": "string"
              },
              {
                "const": "typed-settled",
                "type": "string"
              },
              {
                "const": "process-spawn",
                "type": "string"
              },
              {
                "const": "process-stdin",
                "type": "string"
              },
              {
                "const": "process-stdout",
                "type": "string"
              },
              {
                "const": "process-stderr",
                "type": "string"
              },
              {
                "const": "process-exit",
                "type": "string"
              },
              {
                "const": "herdr-command",
                "type": "string"
              },
              {
                "const": "herdr-result",
                "type": "string"
              }
            ]
          },
          "fields": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {}
            }
          }
        },
        "required": [
          "seq",
          "at_ms",
          "boundary",
          "direction",
          "operation",
          "fields"
        ]
      }
    }
  },
  "required": [
    "schema",
    "scenario",
    "source",
    "seed",
    "events"
  ]
}
